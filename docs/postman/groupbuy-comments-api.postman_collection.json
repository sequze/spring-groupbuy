{
  "info": {
    "name": "GroupBuy Comments API",
    "description": "Postman checks for the required REST API and AJAX JSON error flow. Start the app first, apply demo-seed.sql or set username/password/purchaseItemId variables to existing data, then run requests in order. The login request still uses CSRF, but the comments API requests do not.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "anna@groupbuy.test"
    },
    {
      "key": "password",
      "value": "password"
    },
    {
      "key": "purchaseItemId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Get Login Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login page is returned', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const match = pm.response.text().match(/name=\"_csrf\"\\s+value=\"([^\"]+)\"/);",
              "pm.test('CSRF token is present', function () {",
              "  pm.expect(match, 'csrf token').to.not.equal(null);",
              "});",
              "if (match) {",
              "  pm.collectionVariables.set('csrfToken', match[1]);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "text"
            },
            {
              "key": "_csrf",
              "value": "{{csrfToken}}",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login redirects or lands on workspaces', function () {",
              "  pm.expect([200, 302]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List Comments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/comments?purchaseItemId={{purchaseItemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List returns JSON array', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create Comment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purchaseItemId\": {{purchaseItemId}},\n  \"content\": \"Postman REST check comment\"\n}"
        },
        "url": "{{baseUrl}}/api/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Comment is created', function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.id).to.exist;",
              "  pm.collectionVariables.set('commentId', json.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Get Comment",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/comments/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Comment can be fetched', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('commentId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Update Comment",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Postman REST check comment updated\"\n}"
        },
        "url": "{{baseUrl}}/api/comments/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Comment is updated', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.edited).to.eql(true);",
              "  pm.expect(json.content).to.contain('updated');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Validation Error Returns JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purchaseItemId\": {{purchaseItemId}},\n  \"content\": \"\"\n}"
        },
        "url": "{{baseUrl}}/api/comments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Validation returns JSON error', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().message).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Delete Comment",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/comments/{{commentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Comment is deleted', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
